# Couverture des tests unitaires : python -m pytest --cov  (voir tests/unit/README.md)
[run]
source = cos_service
branch = True
# Chemins relatifs dans coverage-report.xml : SonarQube rattache les lignes aux fichiers
# quel que soit le dossier de travail du runner (/builds/...).
relative_files = True
omit =
    */__pycache__/*
    */tests/*

[report]
show_missing = True
skip_covered = False
precision = 1
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    if TYPE_CHECKING:

[html]
directory = htmlcov

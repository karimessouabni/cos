# Couverture des tests unitaires : python -m pytest --cov  (voir tests/README.md)
[run]
source = cos_service
branch = True
omit =
    */__pycache__/*
    */tests/*

[report]
show_missing = True
skip_covered = False
precision = 1
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    if TYPE_CHECKING:

[html]
directory = htmlcov
